{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:sdk && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" nuxt build && npm run check:public-form-bundle && npm run check:built-css",
    "build:e2e": "npm run build:sdk && E2E=1 NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" nuxt build",
    "build:sdk": "esbuild public/widgets/opnform-sdk.js --minify --legal-comments=inline --banner:js='/* eslint-disable */' --outfile=public/widgets/opnform-sdk.min.js",
    "dev": "node --import ./scripts/node-localstorage-polyfill.mjs ./node_modules/nuxt/bin/nuxt.mjs dev",
    "docker-dev": "node --import ./scripts/node-localstorage-polyfill.mjs ./node_modules/nuxt/bin/nuxt.mjs dev --host 0.0.0.0",
    "generate": "npm run build:sdk && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:ssr-cache:built": "node --test tests/ssr-config-cache-built.test.mjs",
    "test:ssr-cache": "node --test tests/ssr-config-cache.test.mjs",
    "test:email-events": "node --test tests/integration-email-status.test.mjs",
    "lint": "eslint --ext .js,.vue .",
    "lint:fix": "eslint . --fix --ext .js,.vue",
    "test": "VITEST=true vitest",
    "test:ui": "VITEST=true vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:dev": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://127.0.0.1:3100} playwright test",
    "check:public-form-bundle": "node scripts/check-public-form-bundle.mjs",
    "check:built-css": "node scripts/check-built-css.mjs",
    "build:amplify": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=4096}\" NITRO_PRESET=aws-amplify npm run build && node scripts/check-amplify-output.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/ix": "^1.2.14",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/octicon": "^1.2.39",
    "@iconify-json/tabler": "^1.2.42",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@playwright/test": "^1.54.2",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "nuxt": "^4.6.2",
    "nuxt-utm": "^0.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "sass": "^1.80.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.48.1",
    "@codemirror/lang-html": "^6.4.12",
    "@gtm-support/vue-gtm": "^3.2.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@microsoft/clarity": "^1.0.2",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^0.11.0",
    "@popperjs/core": "^2.11.8",
    "@sentry/nuxt": "^11.8.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@sentry/vue": "^11.8.0",
    "@stripe/stripe-js": "^5.5.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/vue-query": "^5.104.5",
    "@tanstack/vue-virtual": "^3.13.12",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "@zxing/library": "^0.23.0",
    "chart.js": "^4.5.1",
    "clone-deep": "^4.0.1",
    "codemirror": "^6.0.1",
    "crisp-sdk-web": "^1.2.1",
    "date-fns": "^4.4.0",
    "debounce": "^3.0.0",
    "dompurify": "^3.4.17",
    "embedkit": "^0.1.7",
    "esbuild": "^0.28.2",
    "fuse.js": "^7.0.0",
    "js-sha256": "^0.10.1",
    "libphonenumber-js": "^1.13.15",
    "object-to-formdata": "^4.5.1",
    "overlayscrollbars": "^2.17.0",
    "pdfjs-dist": "^5.4.530",
    "pinia": "^3.0.2",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "quill": "^2.0.2",
    "quill-resize-module": "^2.1.3",
    "tailwindcss": "^4.1.10",
    "v-calendar": "3.1.2",
    "vue-chartjs": "^5.3.4",
    "vue-codemirror": "^6.1.1",
    "vue-confetti": "^2.3.0",
    "vue-country-flag-next": "^2.3.2",
    "vue-draggable-plus": "^0.6.1",
    "vue-json-pretty": "^2.6.0",
    "vue-notion": "^3.0.0",
    "vue-signature-pad": "^3.0.2",
    "vue-stripe-js": "^1.0.4",
    "webcam-easy": "^1.1.1"
  },
  "eslintIgnore": [
    "/lib/jaro-winkler.js"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "fontless@0.2.1": {
      "esbuild": "0.28.2"
    },
    "@janniks/vue3-katex": {
      "katex": "0.18.2"
    }
  }
}
