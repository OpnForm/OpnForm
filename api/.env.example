APP_NAME="OpnForm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

FRONT_URL=https://localhost:3000
FRONT_API_SECRET=secret

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

FILESYSTEM_DRIVER=local

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_TTL=10080
JWT_REMEMBER_TTL=43200
JWT_SECRET=
# Local development only. Keep false in production/Docker deployments.
JWT_SKIP_IP_UA_VALIDATION=false
PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300

# OIDC self-hosted sign-in
OIDC_FORCE_LOGIN=false
# Maximum OIDC sign-in initiations per client IP and connection per minute
OIDC_RATE_LIMIT_PER_MINUTE=100

# Comma-separated IP addresses or CIDRs for a reverse proxy in front of OpnForm.
# Leave empty for a direct Docker deployment. Never use *.
TRUSTED_PROXIES=

STRIPE_KEY=
STRIPE_SECRET=

STRIPE_PROD_PRO_PRODUCT_ID=
STRIPE_PROD_PRO_PRICING_MONTHLY=
STRIPE_PROD_PRO_PRICING_YEARLY=

STRIPE_PROD_DEFAULT_PRODUCT_ID=
STRIPE_PROD_DEFAULT_PRICING_MONTHLY=
STRIPE_PROD_DEFAULT_PRICING_YEARLY=

STRIPE_PROD_BUSINESS_PRODUCT_ID=
STRIPE_PROD_BUSINESS_PRICING_MONTHLY=
STRIPE_PROD_BUSINESS_PRICING_YEARLY=

STRIPE_PROD_ENTERPRISE_PRODUCT_ID=
STRIPE_PROD_ENTERPRISE_PRICING_MONTHLY=
STRIPE_PROD_ENTERPRISE_PRICING_YEARLY=

STRIPE_TEST_PRO_PRODUCT_ID=
STRIPE_TEST_PRO_PRICING_MONTHLY=
STRIPE_TEST_PRO_PRICING_YEARLY=

STRIPE_TEST_DEFAULT_PRODUCT_ID=
STRIPE_TEST_DEFAULT_PRICING_MONTHLY=
STRIPE_TEST_DEFAULT_PRICING_YEARLY=

STRIPE_TEST_BUSINESS_PRODUCT_ID=
STRIPE_TEST_BUSINESS_PRICING_MONTHLY=
STRIPE_TEST_BUSINESS_PRICING_YEARLY=

STRIPE_TEST_ENTERPRISE_PRODUCT_ID=
STRIPE_TEST_ENTERPRISE_PRICING_MONTHLY=
STRIPE_TEST_ENTERPRISE_PRICING_YEARLY=

H_CAPTCHA_SITE_KEY=
H_CAPTCHA_SECRET_KEY=

RE_CAPTCHA_SITE_KEY=
RE_CAPTCHA_SECRET_KEY=

ADMIN_EMAILS=
TEMPLATE_EDITOR_EMAILS=

OPEN_AI_API_KEY=

CADDY_SECRET=
CADDY_AUTHORIZED_IPS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_FONTS_API_KEY=

TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=

ZAPIER_ENABLED=false

# MCP is always enabled on OpnForm Cloud. On self-hosted instances this value
# is the default until an admin saves an override in Settings > MCP & AI agents.
MCP_ENABLED=false
MCP_OBSERVABILITY_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_RATE_LIMIT_PER_HOUR=3000
MCP_DRAFT_CREATES_PER_MINUTE=20
MCP_DRAFT_CREATES_PER_HOUR=200
MCP_DRAFT_HANDOFFS_PER_MINUTE=120
MCP_DRAFT_EDITOR_REQUESTS_PER_MINUTE=240
MCP_DRAFT_PROXY_POOL_PER_MINUTE=6000
MCP_SUBMISSION_EXPORTS_PER_MINUTE=5
MCP_SUBMISSION_EXPORTS_PER_HOUR=30
# Comma-separated OAuth callback origins. Keep this allowlist explicit.
MCP_OAUTH_REDIRECT_DOMAINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,http://localhost,http://127.0.0.1,http://[::1]
MCP_OAUTH_CUSTOM_SCHEMES=chatgpt,claude,cursor,vscode
# Optional issuer override. Defaults to APP_URL.
MCP_AUTHORIZATION_SERVER=
# Stable Passport keys are required on serverless deployments. Keep them in an encrypted environment file.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

FORM_SUMMARY_RATE_LIMIT_PER_MINUTE=30

# Passport OAuth 2.1 is enabled by default so self-hosted admins can activate
# MCP at runtime. Set this to false only to disable the OAuth infrastructure.
# OAUTH_ENABLED=true
OAUTH_ACCESS_TOKEN_TTL=10080
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

SLACK_BOT_TOKEN=

IPINFO_TOKEN=

# Self-hosted license management (set on cloud instances only)
STRIPE_PROD_SELF_HOSTED_PRODUCT_ID=
STRIPE_PROD_SELF_HOSTED_PRICING_MONTHLY=
STRIPE_PROD_SELF_HOSTED_PRICING_YEARLY=

STRIPE_TEST_SELF_HOSTED_PRODUCT_ID=
STRIPE_TEST_SELF_HOSTED_PRICING_MONTHLY=
STRIPE_TEST_SELF_HOSTED_PRICING_YEARLY=

LICENSE_API_ENDPOINT=https://api.opnform.com
LICENSE_CHECKOUT_SUCCESS_URL=https://opnform.com/self-hosted/checkout/success
LICENSE_CHECKOUT_CANCEL_URL=https://opnform.com/self-hosted/checkout/canceled
LICENSE_PORTAL_RETURN_URL=https://opnform.com/self-hosted/checkout/success
