{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PreserveOpnFormAuthenticationState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-3:650556641073:table/vapor_cache"
    },
    {
      "Sid": "RetainOpnFormEmailSending",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:eu-west-3:650556641073:identity/opnform.com"
    }
  ]
}
